.github/workflows/deploy.yml


name: Deploy Terminal Jump

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}

    steps:
      - name: Get project files
        uses: actions/checkout@v4

      - name: Install Java 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'

      - name: Build Java game
        shell: bash
        run: |
          chmod +x ./gradlew
          ./gradlew clean war

      - name: Prepare website
        shell: bash
        run: |
          mkdir -p public
          WAR_FILE=$(find build/libs -maxdepth 1 -name '*.war' -print -quit)
          test -n "$WAR_FILE"
          unzip -q "$WAR_FILE" -d public
          test -f public/index.html
          test -f public/js/game.js

      - name: Configure GitHub Pages
        uses: actions/configure-pages@v5

      - name: Upload website
        uses: actions/upload-pages-artifact@v3
        with:
          path: public

      - name: Deploy website
        id: deployment
        uses: actions/deploy-pages@v4
